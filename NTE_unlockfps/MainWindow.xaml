<Window x:Class="NTE_unlockfps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NTE_unlockfps"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Unloaded="Window_UnLoaded"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        Title="NTE FPS Unlocker" Height="200" Width="350" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    
    <DockPanel Background="{DynamicResource GradientBackground}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Options" Height="23">
                <MenuItem Header="_Setup"  ToolTip="Set game EXE path" Click="Setiings_Item_Click"/>
                <MenuItem Header="_Manual Mode" Click="ManualMode_Item_Click"/>  
                <MenuItem x:Name="check_auto_start" Header="_Auto Start" IsCheckable="True" IsChecked="{Binding AutoStart, Mode=TwoWay}" ToolTip="Quick launch to skip GUI" IsEnabled="False"/>
                <MenuItem x:Name="check_auto_close" Header="_Auto Close" IsCheckable="True" IsChecked="{Binding AutoCloseCfg, Mode=TwoWay}" />
                <MenuItem x:Name="check_power_saving" Header="_Power Saving" IsCheckable="True" IsChecked="{Binding PowerSaving, Mode=TwoWay}" ToolTip="Auto set FPS to 15 and low process priority upon game losing focus"/>
                <MenuItem x:Name="unlimited_fps" Header="_Unlimited FPS" IsCheckable="True" IsChecked="{Binding UnlimitedFps, Mode=TwoWay}"/>
                <MenuItem x:Name="check_game_process_priority" Header="_Game Process Priority">
                    <MenuItem x:Name="ck_realtime" Header="_Realtime" IsCheckable="True" IsChecked="{Binding IsRealtime, Mode=TwoWay}" />
                    <MenuItem x:Name="ck_high" Header="_High" IsCheckable="True" IsChecked="{Binding IsHigh, Mode=TwoWay}" />
                    <MenuItem x:Name="ck_above_normal" Header="_Above Normal" IsCheckable="True" IsChecked="{Binding IsAboveNormal, Mode=TwoWay}" />
                    <MenuItem x:Name="ck_normal" Header="_Normal" IsCheckable="True" IsChecked="{Binding IsNormal, Mode=TwoWay}" />
                    <MenuItem x:Name="ck_below_normal" Header="_Below Normal" IsCheckable="True" IsChecked="{Binding IsBelowNormal, Mode=TwoWay}" />
                    <MenuItem x:Name="ck_low" Header="_Low" IsCheckable="True" IsChecked="{Binding IsLow, Mode=TwoWay}" />
                    <!--MenuItem x:Name="ck_default" Header="_Default" IsCheckable="True" IsChecked="{Binding IsDefault, Mode=TwoWay}" /-->
                </MenuItem>
                <MenuItem Header="_About" Click="About_Item_Click"/>
                <Separator />
                <MenuItem Header="_Exit" Click="Exit_Item_Click"/>
            </MenuItem>
        </Menu>

        <!-- 1. 将 Orientation 改为 Vertical (垂直排列) -->
        <!-- 2. 保持 HorizontalAlignment="Center"，这样内部所有元素都会居中 -->
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0">

            <!-- 第一行：FPS文字和输入框 -->
            <!-- 使用嵌套的StackPanel让它们在同一行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <!-- 底部加点间距 -->
                <TextBlock Text="FPS:" 
                   VerticalAlignment="Center" 
                   FontSize="14"
                   Margin="0,0,10,0"/>

                <xctk:IntegerUpDown Name="numericUpDown1" 
                            Minimum="20" 
                            Maximum="720" 
                                    FontSize="13"
                            Value="{Binding Fps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Increment="1" 
                            ShowButtonSpinner="True" 
                            FormatString="N0" 
                            Width="260" 
                            Height="28" 
                            TextAlignment="Left"/>
            </StackPanel>

            <!-- 第二行：滑块控件 (自动位于正下方并居中) -->
            <Slider Style="{DynamicResource SliderStyle1}" 
            x:Name="sli_main" 
            Width="280" 
            Value="{Binding Fps, Mode=TwoWay}" 
            Maximum="720" 
            Minimum="0"  
            TickPlacement="None" 
            TickFrequency="1" 
            IsSnapToTickEnabled="True" 
            SelectionEnd="{Binding RelativeSource={RelativeSource Self},Path=Value}" 
            ValueChanged="sli_main_ValueChanged"
            IsSelectionRangeEnabled="True" 
            VerticalAlignment="Center"/>

            <!-- 使用 Grid 替代 StackPanel -->
            <Grid Margin="0,15,0,0">

                <!-- 左边的 CheckBox：默认靠左 -->
                <CheckBox x:Name="check_dx11" 
              Content="Use DX11 To Start Game" 
              VerticalContentAlignment="Center" 
              FontSize="13"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              IsChecked="{Binding UseDx11, Mode=TwoWay}">

                    <CheckBox.ToolTip>
                        <ToolTip Content="Try DirectX 11 to launch Game"/>
                    </CheckBox.ToolTip>
                </CheckBox>

                <!-- 右边的 Button：手动设置为靠右 -->
                <Button x:Name="start_but" 
            Content="Start Game" 
            Width="80" 
            Height="25"
            HorizontalAlignment="Right"
            VerticalAlignment="Center" Click="start_but_Click"/>

            </Grid>


        </StackPanel>



    </DockPanel>

    <!-- 在资源字典中定义渐变背景 -->
    <Window.Resources>
        <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFD2E3FE" Offset="1" />
            <GradientStop Color="White" Offset="0" />
        </LinearGradientBrush>
    </Window.Resources>
</Window>
