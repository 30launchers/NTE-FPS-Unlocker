<Window x:Class="NTE_unlockfps.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NTE_unlockfps"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Unloaded="Window_OnUnloaded"
        Title="Setup" Height="300" Width="450" ResizeMode="NoResize" Topmost="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFD2E3FE" Offset="1" />
            <GradientStop Color="White" Offset="0" />
        </LinearGradientBrush>

        <!-- 定义动画 Storyboard -->
        <Storyboard x:Key="SearchingAnimation" RepeatBehavior="Forever">
            <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Duration="00:00:01">
                <DiscreteStringKeyFrame Value="Searching."  KeyTime="0:0:0.0" />
                <DiscreteStringKeyFrame Value="Searching.." KeyTime="0:0:0.33" />
                <DiscreteStringKeyFrame Value="Searching..." KeyTime="0:0:0.66" />
            </StringAnimationUsingKeyFrames>
        </Storyboard>

    </Window.Resources>

    <!-- 改为 DockPanel 以便支持底部停靠 -->
    <DockPanel Background="{DynamicResource GradientBackground}">

        <!-- 1. 底部按钮区域 (放在 DockPanel 最前面以占据底部空间) -->
        <Grid DockPanel.Dock="Bottom">
            <!-- 使用 Grid 配合 HorizontalAlignment 让按钮靠右 -->
            <Button Content="Apply" 
                    Width="80" Height="25" 
                    HorizontalAlignment="Right" Click="Apply_Button_Click"
                     Margin="0,0,10,12"/>

            <!-- 使用 TextBlock 替代 Label，利用 Inlines 属性实现多颜色文本 -->
            <TextBlock HorizontalAlignment="Left" FontSize="13" Margin="10,0,0,12" VerticalAlignment="Center">
                <!-- 静态标题部分，默认黑色 -->
                <Run Text="与游戏通信状态："/>
                <!-- 动态状态部分，给个名字方便后台调用，初始设为绿色"已连接" -->
                <Run x:Name="StatusRun" Text="未连接" Foreground="Red" FontWeight="Bold"/>
            </TextBlock>

        </Grid>

        <!-- 2. 原有的主要内容区域 -->
        <!-- StackPanel 默认填充剩余空间，内容从上往下排列 -->
        <StackPanel>

            <StackPanel Orientation="Vertical" Margin="15">
                <!-- 使用 TextBlock 替代 Label，并设置 TextWrapping="Wrap" -->
                <TextBlock Text="You can also launch the launcher directly; the unlocker will attempt to find its path automatically."
               FontFamily="Meiryo" 
               FontWeight="Medium"
               FontSize="13"
               TextWrapping="Wrap" />
                <TextBlock Text="Searching..." x:Name="SearchStatusText" Foreground="DarkGoldenrod" FontWeight="SemiBold" Margin="0,10,0,0" FontFamily="Meiryo"  FontSize="15" TextWrapping="Wrap"/>

            </StackPanel>


            <!-- 使用 Grid 替代 StackPanel -->
            <!-- 将 Grid 改为 DockPanel -->
            <DockPanel Margin="10,0,10,10" LastChildFill="False">

                <!-- 1. Label 默认在左边 -->
                <Label Content="Launcher Path:" FontFamily="Meiryo" FontSize="15" 
           Foreground="Navy" FontWeight="Medium" VerticalContentAlignment="Center"/>

                <!-- 3. Button 靠右 (注意：在DockPanel中声明顺序很重要，先声明右边的东西) -->
                <Button Content="Browse" Width="75" DockPanel.Dock="Right" Click="Browse_Button_Click"/>

                <!-- 2. TextBox 会自动排列在 Label 和 Button 之间 -->
                <!-- 去掉 Width="200"，让它自适应；或者保留 Width，它会位于中间区域靠右 -->
                <TextBox x:Name="gamepathbox" Text="{Binding GamePath, Mode = OneWay}" 
             Margin="0,0,10,0"
             FontSize="14" 
             VerticalContentAlignment="Center" 
             Width="205"
             HorizontalAlignment="Right"
             DockPanel.Dock="Right">
                    <TextBox.Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Watermark" Text="N/A" Foreground="Gray" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- 这里也可以不写 DockPanel.Dock，它会填满 Label 和 Button 中间的空隙 -->
            </DockPanel>

            <DockPanel Margin="10,0,10,10" LastChildFill="False">

                <!-- 1. Label 默认在左边 -->
                <Label Content="Custom Launch Param:" FontFamily="Meiryo" FontSize="15" 
           Foreground="Navy" FontWeight="Medium" VerticalContentAlignment="Center"/>



                <TextBox x:Name="Param_EXE" TextWrapping="NoWrap" FontSize="14" VerticalContentAlignment="Center"  HorizontalAlignment="Right" DockPanel.Dock="Right" Width="230"  Text="{Binding CustomLaunchParamCfg, Mode = OneWay}" >
                    <TextBox.Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Watermark" Text="Custom Launch Param is disabled" Foreground="Gray" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>



            </DockPanel>

            <!-- 将 Grid 改为 DockPanel -->
            <DockPanel Margin="10,0,10,10" LastChildFill="False">

                <!-- 1. Label 默认在左边 -->
                <Label Content="Game Resolution:" FontFamily="Meiryo" FontSize="15" 
           Foreground="Navy" FontWeight="Medium" VerticalContentAlignment="Center"/>
                <!-- 3. Button 靠右 (注意：在DockPanel中声明顺序很重要，先声明右边的东西) -->
                <ComboBox x:Name="Reso_COMBOBOX" Width="230" DockPanel.Dock="Right" MaxDropDownHeight="150" VerticalContentAlignment="Center" FontSize="14" SelectedIndex="{Binding CustomResolutionCfg,Mode=OneWay}" IsEnabled="False">
                    <ComboBoxItem Content="Do not change"/>
                    <ComboBoxItem Content="3840x2160"/>
                    <ComboBoxItem Content="2560x1440"/>
                    <ComboBoxItem Content="1920x1440"/>
                    <ComboBoxItem Content="1920x1200"/>
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="1680x1050"/>
                    <ComboBoxItem Content="1600x1200"/>
                    <ComboBoxItem Content="1600x1024"/>
                    <ComboBoxItem Content="1600x900"/>
                    <ComboBoxItem Content="1440x1080"/>
                    <ComboBoxItem Content="1440x900"/>
                    <ComboBoxItem Content="1366x768"/>
                    <ComboBoxItem Content="1360x768"/>
                    <ComboBoxItem Content="1280x1440"/>
                    <ComboBoxItem Content="1280x1024"/>
                    <ComboBoxItem Content="1280x960"/>
                    <ComboBoxItem Content="1280x800"/>
                    <ComboBoxItem Content="1280x768"/>
                    <ComboBoxItem Content="1176x664"/>
                    <ComboBoxItem Content="1152x864"/>
                    <ComboBoxItem Content="1024x768"/>
                    <ComboBoxItem Content="800x600"/>
                    <ComboBoxItem Content="720x576"/>
                    <ComboBoxItem Content="720x480"/>
                    <ComboBoxItem Content="640x480"/>
                </ComboBox>
            </DockPanel>


        </StackPanel>
    </DockPanel>
</Window>
